# Copy this file to .env and fill in real values.
# Never commit the real .env file — add it to .gitignore.

# From https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=

# From your database provider (Supabase / Neon) → Connection string (URI, "Pooled" if offered)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# A random long string used to sign login sessions.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# The final public URL of your site, e.g. https://maramdjaballah.com
NEXTAUTH_URL=
